# Publishes ONLY the WhatsApp webhook of our api (CHANNEL=whatsapp). cloudflared-wa (profile
# "tunnel-wa" in docker-compose.yml) points here: the admin panel, /dev and everything else
# stay off the internet. tests/test_compose.py checks this file.
{
	admin off
	auto_https off
}

:8080 {
	@webhook path /webhooks/whatsapp
	handle @webhook {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000
	}
	handle {
		respond 404
	}
}

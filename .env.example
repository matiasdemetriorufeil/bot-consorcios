# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Base de datos ---
# En docker compose, el servicio api usa el host "db" (se sobreescribe en docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=bot_consorcios
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/bot_consorcios

# --- LLM ---
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- ConsorPlus (SOLO LECTURA) ---
CONSORPLUS_BASE_URL=https://consorplus.drufeilccios.com.ar/
CONSORPLUS_USER=
CONSORPLUS_PASSWORD=
# Segundos mínimos entre requests a ConsorPlus.
CONSORPLUS_MIN_REQUEST_INTERVAL=0.5

# --- Chatwoot ---
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# --- General ---
TIMEZONE=America/Argentina/Cordoba

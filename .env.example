# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Base de datos ---
# En docker compose, el servicio api usa el host "db" (se sobreescribe en docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=bot_consorcios
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/bot_consorcios

# --- LLM ---
LLM_PROVIDER=gemini
# Vacío = default por proveedor (anthropic: claude-haiku-4-5, gemini: gemini-3.8-flash).
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Solo Gemini 3.x: low | medium | high (vacío = default del modelo).
GEMINI_THINKING_LEVEL=low
# Precios USD por millón de tokens del modelo en uso (para estimar costos en bot_events).
# gemini-3.8-flash hasta 31/12/2026: 0.75 / 3.75 / 0.075 (desde 2027: 1.50 / 7.50 / 0.15).
# claude-haiku-4-5: 1 / 5 / 0.10 / 1.25 (escritura de cache 5 min).
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
LLM_PRICE_CACHE_READ=
LLM_PRICE_CACHE_WRITE=
# Horario de atención (hora de Córdoba). Días: 0 = lunes ... 6 = domingo.
OFFICE_HOURS_START=09:00
OFFICE_HOURS_END=17:00
OFFICE_WEEKDAYS=[0,1,2,3,4]
# Texto opcional que el bot agrega en urgencias FUERA de horario, después de avisar la
# derivación (por ejemplo a quién llamar y a qué número). Vacío = recomienda avisar al
# encargado del edificio.
EMERGENCY_CONTACT_TEXT=
# Página de autogestión (descargar expensas y comprobantes): el bot la ofrece con la deuda.
# Vacío = no la menciona.
AUTOGESTION_URL=
# Cómo pagar con el código Siro (el bot lo copia tal cual). Vacío = texto predeterminado.
PAYMENT_CODE_HOW_TO=
# Lo de arriba (horario, textos) también se puede cargar en el panel /admin, en
# "Configuración general": el valor del panel tiene prioridad; vacío = se usa el de acá.

# --- ConsorPlus (SOLO LECTURA) ---
CONSORPLUS_BASE_URL=https://consorplus.drufeilccios.com.ar/
CONSORPLUS_USER=
CONSORPLUS_PASSWORD=
# Segundos mínimos entre requests a ConsorPlus.
CONSORPLUS_MIN_REQUEST_INTERVAL=0.5
# Unidad "canario" que se consulta todos los días para detectar cambios en las páginas de
# ConsorPlus: valores de los combos de edificio y unidad (conviene una unidad con deuda).
CANARY_BUILDING=
CANARY_UNIT=
# Minutos durante los que la consulta en vivo reutiliza la última deuda traída (0 = sin cache).
LIVE_CACHE_MINUTES=10
# Minutos sin consultas tras los que se da por vencida la sesión de ConsorPlus (dura ~20).
CONSORPLUS_SESSION_IDLE_MINUTES=15

# --- Chatwoot ---
# Cómo instalarlo, crear el admin, el Agent Bot y los tokens: docs/chatwoot.md
# Desde el contenedor api: http://chatwoot-rails:3000 — desde Windows: http://localhost:3000
CHATWOOT_BASE_URL=http://chatwoot-rails:3000
CHATWOOT_ACCOUNT_ID=
# Token de acceso del Agent Bot: manda mensajes y notas, deriva y pone etiquetas.
CHATWOOT_BOT_TOKEN=
# Token de acceso de un usuario administrador: lee el historial y actualiza contactos.
CHATWOOT_API_TOKEN=
# "Webhook Secret" del Agent Bot: Chatwoot firma cada webhook con él.
CHATWOOT_WEBHOOK_SECRET=
# IDs de las bandejas donde el teléfono del contacto lo pone el canal (en producción, solo
# WhatsApp). Ejemplo: 2 o 2,5. En las demás bandejas el teléfono NO identifica a nadie.
CHATWOOT_TRUSTED_PHONE_INBOX_IDS=
# Token de la bandeja Website, para la página de prueba /dev/chat (solo APP_ENV=development).
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_TIMEOUT_SECONDS=10
# Servicios de Chatwoot del docker-compose (perfil "chatwoot", necesita ~4 GB de RAM libres).
# Descomentar para que `docker compose up` también levante Chatwoot.
# COMPOSE_PROFILES=chatwoot
CHATWOOT_VERSION=v4.18.0
CHATWOOT_FRONTEND_URL=http://localhost:3000
# Solo letras y números. Generar con: python -c "import secrets; print(secrets.token_hex(64))"
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
# Túnel HTTPS de desarrollo hacia Chatwoot (perfil "tunnel", ver docs/whatsapp.md).
# Vacío = la versión fijada en docker-compose.yml.
# CLOUDFLARED_VERSION=2026.9.2
# SOLO DESARROLLO, con el número de prueba de Meta: reescribe el destinatario de WhatsApp.
# Pares "origen:destino" separados por coma, sin "+": origen = el wa_id con 9 (549 + área +
# número), destino = como figura en la lista de Meta (54 + área + 15 + número).
# Vacío = no hace nada. En producción, siempre vacío. Ver docs/whatsapp.md.
CHATWOOT_DEV_WA_RECIPIENT_REWRITE=

# --- Email (códigos de verificación) ---
# console: solo desarrollo, loguea el email (y el código) en vez de mandarlo. smtp: envío real.
EMAIL_BACKEND=console
SMTP_HOST=
# 465 = TLS implícito; cualquier otro puerto usa STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Emails o dominios (separados por coma) que nunca reciben códigos de verificación.
# Una unidad con solo estos emails se trata como "sin email" (va a operador).
VERIFICATION_EMAIL_EXCLUDE=estudiodiegorufeil@gmail.com

# --- Canal ---
# chatwoot: el bot atiende por el Agent Bot de Chatwoot (/webhooks/chatwoot).
# whatsapp: el bot habla directo con la WhatsApp Cloud API (/webhooks/whatsapp). Ver
# docs/whatsapp.md, "Canal directo".
CHANNEL=chatwoot

# --- WhatsApp Cloud API ---
# Con CHANNEL=chatwoot, los dos identificadores se cargan en la bandeja de Chatwoot y el token
# permanente se pega solo en Chatwoot. Con CHANNEL=whatsapp, todo esto lo usa nuestra api.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Token permanente del usuario del sistema (solo CHANNEL=whatsapp).
WHATSAPP_ACCESS_TOKEN=
# Clave secreta de la app de Meta: firma cada webhook (sin ella, todo se rechaza).
WHATSAPP_APP_SECRET=
# Lo inventás vos y lo pegás en Meta al configurar el webhook. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API. Vacío = la fijada en app/config.py.
# WHATSAPP_GRAPH_VERSION=v26.0
# Adjuntos entrantes (volumen wa_media del contenedor api) y su tamaño máximo en bytes.
WHATSAPP_MEDIA_DIR=/data/wa_media
WHATSAPP_MEDIA_MAX_BYTES=10485760
# Al arrancar, los mensajes sin responder más nuevos que esto se responden; los más viejos no.
WHATSAPP_RECOVERY_MINUTES=15
# SOLO DESARROLLO (APP_ENV=development; si no, se ignora), con el número de prueba: igual que
# CHATWOOT_DEV_WA_RECIPIENT_REWRITE, pero en nuestro cliente. Vacío = no hace nada.
WHATSAPP_DEV_RECIPIENT_REWRITE=
# Túnel de desarrollo que publica SOLO /webhooks/whatsapp (perfil "tunnel-wa").
# CADDY_VERSION=2.10.2-alpine

# --- General ---
# development: habilita /dev/chat. En producción: production.
APP_ENV=development
# Logs de la app en `docker compose logs api`: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
TIMEZONE=America/Argentina/Cordoba

# --- Panel de administración (/admin) ---
# Si falta alguno de los tres, el panel rechaza todos los ingresos.
ADMIN_USERNAME=
# Hash de la contraseña (nunca la contraseña): uv run python scripts/hash_admin_password.py
ADMIN_PASSWORD_HASH=
# Firma la cookie de sesión. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
